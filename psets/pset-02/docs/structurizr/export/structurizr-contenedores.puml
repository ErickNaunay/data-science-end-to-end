person "==Asesor de inversiones\n<size:16>[Person]</size>\n\nUsuario de la herramienta: lanza el backfill, revisa las ejecuciones y consume la OBT para la decisión mensual." <<Element-RWxlbWVudCxQZXJzb24=>> as Asesordeinversiones
rectangle "==Yahoo Finance\n<size:16>[Software System]</size>\n\nPrecios diarios OHLCV y cierre ajustado (API no oficial, vía yfinance): acciones, ^GSPC, ^NYA, ^IRX." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubw==>> as YahooFinance
rectangle "==GitHub (fuentes de referencia)\n<size:16>[Software System]</size>\n\nComposición histórica del S&P 500 (chinobing) y listados de bolsa (rreichel3)." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJubw==>> as GitHubfuentesdereferencia

rectangle "Pipeline de datos del portafolio\n<size:16>[Software System]</size>" <<Boundary-UGlwZWxpbmUgZGUgZGF0b3MgZGVsIHBvcnRhZm9saW8=>> {
  rectangle "==spark-master\n<size:16>[Container: Spark 3.5.3 · RPC :7077 · UI :8081]</size>\n\nCoordina los recursos del clúster; servicio persistente de Compose." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Pipelinededatosdelportafolio.sparkmaster
  rectangle "==spark-worker\n<size:16>[Container: Spark 3.5.3 · pset2-spark]</size>\n\nEjecuta las tareas distribuidas; ofrece 2 GB al ejecutor." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Pipelinededatosdelportafolio.sparkworker
  database "==Snowflake · base PORTAFOLIO\n<size:16>[Container: SaaS]</size>\n\nEsquemas RAW, BRONZE, SILVER, GOLD, OBT y CALIDAD. Bodega PSET2_WH (XSMALL, autosuspensión)." <<Element-RWxlbWVudCxDb250YWluZXIsQmFzZURhdG9z>> as Pipelinededatosdelportafolio.SnowflakebasePORTAFOLIO
  rectangle "==Kestra\n<size:16>[Container: Kestra 2.0 · Docker · UI :8090]</size>\n\nOrquestación: flows ingesta_diaria (L–V 18:30 NY, retries, recuperación), backfill_historico (por año) y transformar." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Pipelinededatosdelportafolio.Kestra
  database "==Postgres\n<size:16>[Container: PostgreSQL 18 · Docker]</size>\n\nEstado interno de Kestra (flows, ejecuciones, colas)." <<Element-RWxlbWVudCxDb250YWluZXIsQmFzZURhdG9z>> as Pipelinededatosdelportafolio.Postgres
  rectangle "==Tarea de ingesta\n<size:16>[Container: Python 3.12 · imagen pset2-ingesta]</size>\n\nextraer_cargar.py: descarga precios, composición y listados; traduce símbolos con equivalencias_tickers y carga a RAW (append-only, con lote)." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Pipelinededatosdelportafolio.Tareadeingesta
  rectangle "==Tarea dbt\n<size:16>[Container: dbt Core + dbt-snowflake · imagen pset2-dbt]</size>\n\ndbt build: Bronze (staging: tipos, deduplicación), Silver (calendario NYSE, imputación de huecos cortos, retornos, membresía), Gold (dos hechos y tres dimensiones, incluida membresía histórica) y CALIDAD; tests de integridad y negocio." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Pipelinededatosdelportafolio.Tareadbt
  rectangle "==Driver Spark / tarea OBT\n<size:16>[Container: Spark 3.5.3 · pset2-spark · tarea efímera]</size>\n\nconstruir_obt.py: lee Gold, construye acción por mes, verifica 13 controles y escribe OBT. Ejecutor 2 GB; driver 1 GB; un core total." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Pipelinededatosdelportafolio.DriverSparktareaOBT
}

Asesordeinversiones --> Pipelinededatosdelportafolio.Kestra <<Relationship-UmVsYXRpb25zaGlw>> : "Lanza el backfill y supervisa ejecuciones\n<size:16>[UI en localhost:8090]</size>"
Pipelinededatosdelportafolio.Kestra --> Pipelinededatosdelportafolio.Postgres <<Relationship-UmVsYXRpb25zaGlw>> : "Guarda su estado en"
Pipelinededatosdelportafolio.Kestra --> Pipelinededatosdelportafolio.Tareadeingesta <<Relationship-UmVsYXRpb25zaGlw>> : "Ejecuta como contenedor de tarea (trigger L–V 18:30 NY; reintentos exponenciales)"
Pipelinededatosdelportafolio.Kestra --> Pipelinededatosdelportafolio.Tareadbt <<Relationship-UmVsYXRpb25zaGlw>> : "Ejecuta al terminar la ingesta (subflow transformar)"
Pipelinededatosdelportafolio.Kestra --> Pipelinededatosdelportafolio.DriverSparktareaOBT <<Relationship-UmVsYXRpb25zaGlw>> : "Ejecuta spark-submit tras dbt"
Pipelinededatosdelportafolio.Tareadeingesta --> YahooFinance <<Relationship-UmVsYXRpb25zaGlw>> : "Descarga OHLCV diario (yfinance, por lotes con reintentos)"
Pipelinededatosdelportafolio.Tareadeingesta --> GitHubfuentesdereferencia <<Relationship-UmVsYXRpb25zaGlw>> : "Descarga composición histórica y listados de bolsa"
Pipelinededatosdelportafolio.Tareadeingesta --> Pipelinededatosdelportafolio.SnowflakebasePORTAFOLIO <<Relationship-UmVsYXRpb25zaGlw>> : "Carga RAW con write_pandas (append-only + bitácora)"
Pipelinededatosdelportafolio.Tareadbt --> Pipelinededatosdelportafolio.SnowflakebasePORTAFOLIO <<Relationship-UmVsYXRpb25zaGlw>> : "Transforma RAW → BRONZE → SILVER → GOLD y calcula CALIDAD.DQ_METRICAS"
Pipelinededatosdelportafolio.DriverSparktareaOBT --> Pipelinededatosdelportafolio.sparkmaster <<Relationship-UmVsYXRpb25zaGlw>> : "Solicita recursos del clúster\n<size:16>[spark://spark-master:7077]</size>"
Pipelinededatosdelportafolio.sparkmaster --> Pipelinededatosdelportafolio.sparkworker <<Relationship-UmVsYXRpb25zaGlw>> : "Asigna ejecutores"
Pipelinededatosdelportafolio.DriverSparktareaOBT --> Pipelinededatosdelportafolio.sparkworker <<Relationship-UmVsYXRpb25zaGlw>> : "Coordina tareas y resultados"
Pipelinededatosdelportafolio.sparkworker --> Pipelinededatosdelportafolio.SnowflakebasePORTAFOLIO <<Relationship-UmVsYXRpb25zaGlw>> : "Lee y escribe particiones mediante el conector Snowflake"
Pipelinededatosdelportafolio.DriverSparktareaOBT --> Pipelinededatosdelportafolio.SnowflakebasePORTAFOLIO <<Relationship-UmVsYXRpb25zaGlw>> : "Lee GOLD y escribe OBT.OBT_ACCION_MES y VALIDACION_OBT"
Asesordeinversiones --> Pipelinededatosdelportafolio.SnowflakebasePORTAFOLIO <<Relationship-UmVsYXRpb25zaGlw>> : "Consulta la OBT y las métricas de calidad\n<size:16>[Snowsight]</size>"

@enduml